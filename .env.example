# ─── Archive Lens environment ────────────────────────────────────────────────
# Copy to .env.local for local development. Every variable is optional:
# the app runs in full demo mode with no configuration at all.

# ── Demo mode ────────────────────────────────────────────────────────────────
# "1" forces demo mode: search runs only against the bundled local index of
# verified archive records, with no outbound requests. Useful offline, in CI,
# and for Playwright runs. When unset, live providers are used and the demo
# index is still searchable as its own provider.
DEMO_MODE=

# ── National Archives Catalog (NARA) ─────────────────────────────────────────
# The Catalog API v2 requires a free API key. Request one from NARA:
#   https://catalog.archives.gov/api/v2/api-docs  (see also
#   https://www.archives.gov/research/catalog/help/api)
# Without a key the NARA provider is disabled and the UI shows setup guidance
# instead of errors.
NARA_API_KEY=

# ── Anthropic (optional AI assistance) ───────────────────────────────────────
# When present, Claude is used for query expansion and for the evidence-grounded
# "Worldview at the Time" synthesis. Without a key both features fall back to
# the built-in rule-based engines; search and the document workflow are fully
# functional either way.
ANTHROPIC_API_KEY=
# Runtime model is configurable; never hardcoded in the app.
ANTHROPIC_MODEL=claude-sonnet-5

# ── Politeness / networking ──────────────────────────────────────────────────
# Identify the app to archive servers (some providers ask for a contact).
ARCHIVE_LENS_USER_AGENT="ArchiveLens/0.1 (research tool; local use)"
# Override provider request timeout in milliseconds (default 12000).
PROVIDER_TIMEOUT_MS=

# ── Storage ──────────────────────────────────────────────────────────────────
# SQLite file for the research notebook (projects, saved sources, notes, tags).
# Defaults to ./data/archive-lens.db
DATABASE_PATH=
